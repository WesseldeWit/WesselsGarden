.theme-toggle-input {
  position: absolute;
  opacity: 0;
  pointer-events: none;
}

.theme-toggle-label {
  position: fixed;
  bottom: 20px;
  right: 20px;
  z-index: 10;
  cursor: pointer;
  font-family: "bebas-neue", sans-serif;
  color: var(--text-color);
  border: 1px solid var(--text-color);
  padding: 6px 12px;
  
}
.mode-dark {
  display: none;
}

body:has(#theme-toggle:checked) .mode-light {
  display: none;
}

body:has(#theme-toggle:checked) .mode-dark {
  display: inline;
}

body:has(#theme-toggle:checked) {
  --text-color: white;
  --background-color: black;
  background-image: url("/achtergond-dark.png");
}


@media (width < 45em) {
  body {
    height: auto;
    min-height: 100vh;
  }

 .trap {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.4rem 1.5rem;
  padding-top: 5rem;
  padding-inline: 1rem;
  aspect-ratio: auto;
  overflow: visible;
  grid-auto-flow: dense;
}

  .trap span {
    position: static;
    font-size: 1rem;
  }

  .h,
  .v {
    transform: none;
  }

  .trap span.gezondheid,
  .trap span.sporten,
  .trap span.focus,
  .trap span.Wessel-de-Wit {
    font-size: 2rem;
  }

  .gezondheid, .groene-appels, .water, .ei, .kwark, .spa {
  grid-column: 1;
}

.sporten, .hardlopen, .racefietsen, .gym, .padel, .hockey {
  grid-column: 2;
}

.focus, .leergierig, .scherp, .discipline, .aardig, .eerlijk, .creatief {
  grid-column: 1;
}

.Wessel-de-Wit, .Amsterdam, .Heiloo, .Jan-Wessel-Cornelis {
  grid-column: 2;
}


.focus,
.Wessel-de-Wit {
  margin-top: 1.5rem;
}
}