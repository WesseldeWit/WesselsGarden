/* HIER KOMT JOUW CSS */

html {
  --text-color: black;
  --background-color: #e8e7e3;
}

@font-face {
  font-family: "bebas-neue";
  src: url("../type/BebasNeue-Regular.ttf");
  font-weight: 400;
  font-style: normal;
}

@font-face {
  font-family: "oswald";
  src: url("../type/Oswald-Regular.ttf");
  font-weight: 400;
  font-style: normal;
}

@property --glow-hue {
  syntax: "<number>";
  initial-value: 200;
  inherits: false;
}

@property --glow-blur {
  syntax: "<number>";
  initial-value: 4;
  inherits: false;
}


body {
  margin: 0;
  background-color: var(--background-color);
  background-image: url("/achtergond-light.png");
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  height: 100vh;
  display: flex;
  justify-content: center;
}

.trap {
  position:relative;
  width: 100%;
  aspect-ratio: 1/1;
  overflow: hidden;
  font-family: "oswald",sans-serif;
}



.trap a {
  color: inherit;
  text-decoration: none;
  font: inherit;
  cursor: pointer;
}

.trap span {
  position: absolute;
  transition: color 0.3s ease, transform 0.2s ease;
}

.h {
  transform:translate(0,-50%);
}

.v {
  transform:translate(-50%,0) rotate(270deg);
}

/*traptreden h1*/
